# ============================================================
# EXECUTOR STATUS BOT - ENVIRONMENT CONFIGURATION
# ============================================================

# Discord Bot Credentials
# Obtain these from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here
ADMIN_ROLE_ID=your_admin_role_id_here
STATUS_CHANNEL_ID=your_status_channel_id_here

# Primary Status API (ExecutorsOnline)
# Docs: https://www.executors.online/docs/api
PRIMARY_API_ENABLED=true
PRIMARY_API_URL=https://executors.online/api/executors
PRIMARY_API_KEY=
PRIMARY_API_TIMEOUT_MS=10000

# Secondary Status API (RobloxExecutors)
# Docs: https://robloxexecutors.com/api
SECONDARY_API_ENABLED=true
SECONDARY_API_URL=https://robloxexecutors.com/api/v1/executors
SECONDARY_API_KEY=
SECONDARY_API_TIMEOUT_MS=10000

# Standard Generic Status API variables (backward compatibility)
STATUS_API_URL=https://executors.online/api/executors
STATUS_API_KEY=
STATUS_POLL_INTERVAL_SECONDS=300
STATUS_API_TIMEOUT_MS=10000

# Source Precedence: API_FIRST or MANUAL_FIRST
DEFAULT_SOURCE_PRECEDENCE=API_FIRST

# Stale Data Threshold (Seconds after which data is considered STALE)
STALE_THRESHOLD_SECONDS=1800

# Database Configuration
DATABASE_PATH=./data/executor_status.sqlite

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
